# Copy this file to ".env" and adjust if needed.
# .env is git-ignored so nothing sensitive is committed.

# Path to the raw Kaggle orders.csv
ORDERS_CSV=C:\Users\singh\Desktop\orders.csv

# SQL Server connection
MSSQL_SERVER=localhost
MSSQL_DB=retail
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Auth: "windows" (Windows Authentication, no password) or "sql"
MSSQL_AUTH=windows

# Only needed when MSSQL_AUTH=sql
# MSSQL_USER=sa
# MSSQL_PASSWORD=your_password_here
